{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "allowJs": true,
    "types": ["node"]
  },
  // `e2e/**/*.ts` 不在这里：它由 tsconfig.e2e.json 单独检查（那份才带 dom lib）。
  // 单元测试跑在 node 环境，把 dom 加进本工程会让「服务端代码误用浏览器 API」查不出来。
  "include": ["apps/*/test/**/*.ts", "packages/*/test/**/*.ts", "*.config.ts"]
}
