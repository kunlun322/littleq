{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["apps/*/test/**/*.ts", "packages/*/test/**/*.ts", "e2e/**/*.ts", "*.config.ts"]
}
