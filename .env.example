# 本地和 Docker：复制为项目根目录的 .env.local 后填写。
# Vercel：在 Project Settings > Environment Variables 添加同名变量。
# 所有 Key 只在服务端使用，不要添加 NEXT_PUBLIC_ 前缀或把真实值提交到仓库。

# 本地/Docker 单进程可以留空，使用持久化 PGlite；Vercel/多实例必须填写 PostgreSQL 连接串。
DATABASE_URL=
# 本地 PGlite 目录；Compose 固定为 /app/.data/pglite，数据卷挂载到 /app/.data。
PGLITE_DIR=./.data/pglite

# 创作伙伴后端：qca 或 bailian。默认方案为 qca。
AI_PROVIDER=qca
# QCA 的 Personal Access Token 填在这里；完整功能必填，智能体作品始终需要它。
QODER_API_KEY=
QCA_BASE_URL=https://api.qoder.com/api/v1/forward
QCA_MODEL=qmodel_38max
QCA_AGENT_MODEL=qfmodel
# 可选：同一 QCA 账号的现有 Environment ID；留空自动查找或创建。
QCA_ENVIRONMENT_ID=
AGENT_TURNS_PER_CHAT=40
AGENT_DAILY_LIMIT=400

# AI_PROVIDER=bailian 时，百炼/DashScope API Key 填在 AI_API_KEY。
# 该模式只切换创作伙伴；智能体作品仍使用上面的 QODER_API_KEY。
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3-coder-flash

# 仅控制 Docker Compose 的宿主端口；容器内部固定 80。
# 使用 docker compose --env-file .env.local up -d --build 使此项参与插值。
HOST_PORT=80
