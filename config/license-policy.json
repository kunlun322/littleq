        "status": "pending-architect",
        "license": "BlueOak-1.0.0",
        "match": { "names": ["minimatch"], "versions": ["10.2.6"] },
        "distributed": false,
        "usage": "eslint 配置解析的 glob 匹配，仅构建期使用，不进入任何交付产物",
        "introducedBy": [
          "devDependency eslint@10.12.0",
          "@eslint/config-array@0.23.5",
          "minimatch@10.2.6"
