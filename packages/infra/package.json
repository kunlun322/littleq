    "@littleq/domain": "workspace:*",
    "@neondatabase/serverless": "1.2.0",
    "@vercel/blob": "2.8.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
