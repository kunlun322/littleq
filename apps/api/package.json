{
  "name": "@littleq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "LittleQ 主站 API（ZLQ-153 §1.3）：组合根之一，装配领域用例与 infra 驱动，并以 node:http 暴露 /api/v1 端点。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@littleq/api-contract": "workspace:*",
    "@littleq/application": "workspace:*",
    "@littleq/domain": "workspace:*",
    "@littleq/infra": "workspace:*",
    "@littleq/work-contract": "workspace:*",
    "cookie": "2.0.1",
    "server-only": "0.0.1"
  }
}
